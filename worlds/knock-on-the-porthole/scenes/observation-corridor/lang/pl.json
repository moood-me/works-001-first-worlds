  {"text":"SUIT 02 · CH. 2","translation":"SKAF. 02 · KAN. 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"COMMS","translation":"ŁĄCZNOŚĆ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"JAMMED","translation":"ZACIĘTA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AJAR","translation":"UCHYLONA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"LIDA · CORRIDOR 2-4","translation":"LIDA · KORYTARZ 2-4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2: {state}","translation":"ŚLUZA 2: {state}","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CREW ON BOARD: 3/3","translation":"ZAŁOGA NA POKŁADZIE: 3/3","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: VOICE","translation":"KAN. 2: GŁOS","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: NOISE","translation":"KAN. 2: SZUM","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2  →","translation":"ŚLUZA 2  →","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"DECK 2 · SECT. 4","translation":"POKŁAD 2 · SEKC. 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"CHECK PRESSURE BEFORE EXIT","translation":"SPRAWDŹ CIŚNIENIE PRZED WYJŚCIEM","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"←  AIRLOCK 2","translation":"←  ŚLUZA 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"OBSERVATION BAY · 4","translation":"PRZEDZIAŁ OBSERWACYJNY · 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"O₂ · EMERG. MASKS","translation":"O₂ · MASKI AWAR.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"Corridor by the Observation Bay","translation":"Korytarz przy przedziale obserwacyjnym","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json title"},
  {"text":"The Ladoga, deck 2. Emergency lighting, frost on the gratings, the airlock jammed.","translation":"„Ładoga”, pokład 2. Światło awaryjne, szron na kratach, śluza zaklinowana.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json caption"},
  {"text":"The doors of airlock 2 have opened all the way. Cold drifts out of the chamber, vapour creeps across the floor.","translation":"Wrota śluzy nr 2 rozsunęły się do końca. Z komory ciągnie chłodem, po podłodze ściele się para.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The doors of airlock 2 have parted a hand's width and stuck.","translation":"Wrota śluzy nr 2 rozsunęły się na szerokość dłoni i stanęły.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Airlock 2 has closed and locked.","translation":"Śluza nr 2 zamknęła się i zablokowała.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has reached the airlock and taken hold of the manual drive's handle.","translation":"Wiera doszła do śluzy i chwyciła rękojeść napędu ręcznego.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has stopped at a porthole; beyond the glass, the red disc of the dwarf.","translation":"Wiera zatrzymała się przy iluminatorze; za szybą – czerwona tarcza karła.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has gone back to the observation bay hatch.","translation":"Wiera wróciła do włazu przedziału obserwacyjnego.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has disappeared into the airlock.","translation":"Wiera zniknęła w śluzie.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"A trail of frost footprints from the airlock has reached the observation bay hatch.","translation":"Łańcuszek oszronionych śladów od śluzy dotarł do włazu przedziału obserwacyjnego.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Ten percent of the oxygen is left in the corridor.","translation":"W korytarzu zostało dziesięć procent tlenu.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The speaker by the airlock has come alive: hiss on the channel of suit 2, as if someone is holding down the talk button.","translation":"Głośnik przy śluzie ożył: szum na kanale skafandra nr 2, jakby ktoś trzymał wciśnięty przycisk nadawania.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"}
]}
