{"strings": [
  {"text":"WAIT BEHIND THE YELLOW LINE","translation":"ЧЕКАЙТЕ ЗА ЖОВТОЮ ЛІНІЄЮ","where":"worlds/window-3/scenes/window-3/elements/deck.js"},
  {"text":"COFFEE 40 cr","translation":"КАВА · 40 кр","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"NO QUEUE*","translation":"БЕЗ ЧЕРГИ*","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"hot","translation":"гаряча","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"*except coffee","translation":"*крім кави","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
