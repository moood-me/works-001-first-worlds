{"strings": [
  {"text":"AFT · HOLD 1","translation":"RUFA · ŁADOWNIA 1","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"SEALED","translation":"ZAPLOMBOWANE","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"AIRLOCK 2","translation":"ŚLUZA 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"LOCKED","translation":"ZABLOKOWANA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"STUCK","translation":"ZAKLINOWANA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
