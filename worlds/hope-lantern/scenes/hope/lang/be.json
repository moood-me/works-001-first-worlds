{"strings": [
  {"text":"Hope","translation":"Надзея · Hope","where":"worlds/hope-lantern/scenes/hope/scene.json title"},
  {"text":"The lantern burns as long as someone is waiting.","translation":"Ліхтар гарыць, пакуль нехта чакае.","where":"worlds/hope-lantern/scenes/hope/scene.json caption"},
  {"text":"Every evening she comes to the old pier.","translation":"Кожны вечар яна прыходзіць на стары прычал.","where":"worlds/hope-lantern/scenes/hope/scene.json captions[0] text"},
  {"text":"And lights the lantern.","translation":"І запальвае ліхтар.","where":"worlds/hope-lantern/scenes/hope/scene.json captions[1] text"},
  {"text":"So that from the far shore they can see where to row.","translation":"Каб з таго берага было відаць, куды плыць.","where":"worlds/hope-lantern/scenes/hope/scene.json captions[2] text"},
  {"text":"Over there it's still dark.","translation":"Там пакуль цёмна.","where":"worlds/hope-lantern/scenes/hope/scene.json captions[3] text"},
  {"text":"But the lantern burns.","translation":"Але ліхтар гарыць.","where":"worlds/hope-lantern/scenes/hope/scene.json captions[4] text"}
]}
