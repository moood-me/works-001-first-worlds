  {"text":"STUCK","translation":"EMPERRADA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"PARTLY OPEN","translation":"ENTREABERTA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"OPEN","translation":"ABERTA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"MANUAL DRIVE","translation":"ACIONAMENTO MANUAL","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"SUIT 02 · CH. 2","translation":"TRAJE 02 · CAN. 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"COMMS","translation":"COMUNICAÇÃO","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"JAMMED","translation":"EMPERRADA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AJAR","translation":"ENTREABERTA","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"LIDA · CORRIDOR 2-4","translation":"LIDA · CORREDOR 2-4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2: {state}","translation":"ECLUSA 2: {state}","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CREW ON BOARD: 3/3","translation":"TRIPULAÇÃO A BORDO: 3/3","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: VOICE","translation":"CAN. 2: VOZ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: NOISE","translation":"CAN. 2: RUÍDO","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2  →","translation":"ECLUSA 2  →","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"DECK 2 · SECT. 4","translation":"DEQUE 2 · SEÇ. 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"CHECK PRESSURE BEFORE EXIT","translation":"VERIFIQUE A PRESSÃO ANTES DE SAIR","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"←  AIRLOCK 2","translation":"←  ECLUSA 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"OBSERVATION BAY · 4","translation":"BAIA DE OBSERVAÇÃO · 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"O₂ · EMERG. MASKS","translation":"O₂ · MÁSC. DE EMERG.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"Corridor by the Observation Bay","translation":"Corredor junto à baia de observação","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json title"},
  {"text":"The Ladoga, deck 2. Emergency lighting, frost on the gratings, the airlock jammed.","translation":"A Ladoga, deque 2. Luz de emergência, geada nas grades, a eclusa emperrada.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json caption"},
  {"text":"The doors of airlock 2 have opened all the way. Cold drifts out of the chamber, vapour creeps across the floor.","translation":"As portas da eclusa 2 se abriram por completo. Sai frio da câmara, o vapor se arrasta pelo chão.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The doors of airlock 2 have parted a hand's width and stuck.","translation":"As portas da eclusa 2 se abriram um palmo e emperraram.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Airlock 2 has closed and locked.","translation":"A eclusa 2 se fechou e travou.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has reached the airlock and taken hold of the manual drive's handle.","translation":"Vera chegou à eclusa e segurou a manivela do acionamento manual.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has stopped at a porthole; beyond the glass, the red disc of the dwarf.","translation":"Vera parou numa escotilha; atrás do vidro, o disco vermelho da anã.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has gone back to the observation bay hatch.","translation":"Vera voltou à escotilha da baia de observação.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has disappeared into the airlock.","translation":"Vera desapareceu dentro da eclusa.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"A trail of frost footprints from the airlock has reached the observation bay hatch.","translation":"Uma trilha de pegadas de geada saindo da eclusa chegou à escotilha da baia de observação.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Ten percent of the oxygen is left in the corridor.","translation":"Restam dez por cento de oxigênio no corredor.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The speaker by the airlock has come alive: hiss on the channel of suit 2, as if someone is holding down the talk button.","translation":"O alto-falante junto à eclusa ganhou vida: chiado no canal do traje 2, como se alguém estivesse segurando o botão de falar.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"}
]}
