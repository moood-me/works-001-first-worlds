  {"text":"Window 3","translation":"Ventanilla 3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Una cola electrónica en el cinturón de asteroides. Aquí nadie tiene prisa. Salvo usted.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Puesto de control Cinturón-Este. A Júpiter, cuarenta minutos de vuelo. A la ventanilla, once días.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Inventaron el motor de curvatura. Lo que no consiguieron fue suprimir el formulario F-12 por triplicado.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Guena lo rellenó dos veces. La tercera copia se fue flotando.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"La ventanilla 3 vuelve a estar abierta.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"La ventanilla 3 ha cerrado por descanso técnico.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Un yate dorado con luz giratoria ha ido directo a la ventanilla, sin hacer cola. Su número ha sido recalculado.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} días","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
