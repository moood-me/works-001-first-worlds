{"strings": [
  {"text":"AFT · HOLD 1","translation":"КОРМА · ТРЮМ 1","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"SEALED","translation":"ОПЕЧАТАНО","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"AIRLOCK 2","translation":"ШЛЮЗ 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"LOCKED","translation":"ЗАБЛОКИРОВАН","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"STUCK","translation":"ЗАКЛИНИЛО","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"PARTLY OPEN","translation":"ОТКРЫТ ЧАСТ.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"OPEN","translation":"ОТКРЫТ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"MANUAL DRIVE","translation":"РУЧНОЙ ПРИВОД","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"SUIT 02 · CH. 2","translation":"СКАФ. 02 · КАН. 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"COMMS","translation":"СВЯЗЬ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"JAMMED","translation":"ЗАКЛИНЕН","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AJAR","translation":"ПРИОТКРЫТ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"LIDA · CORRIDOR 2-4","translation":"ЛИДА · КОРИДОР 2-4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2: {state}","translation":"ШЛЮЗ 2: {state}","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CREW ON BOARD: 3/3","translation":"ЭКИПАЖ НА БОРТУ: 3/3","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: VOICE","translation":"КАН. 2: ГОЛОС","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: NOISE","translation":"КАН. 2: ШУМ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2  →","translation":"ШЛЮЗ 2  →","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"DECK 2 · SECT. 4","translation":"ПАЛУБА 2 · СЕКЦ. 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"CHECK PRESSURE BEFORE EXIT","translation":"ПРОВЕРЬ ДАВЛЕНИЕ ПЕРЕД ВЫХОДОМ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"←  AIRLOCK 2","translation":"←  ШЛЮЗ 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"OBSERVATION BAY · 4","translation":"СМОТРОВОЙ ОТСЕК · 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"O₂ · EMERG. MASKS","translation":"O₂ · АВАР. МАСКИ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"Corridor by the Observation Bay","translation":"Коридор у смотрового отсека","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json title"},
  {"text":"The Ladoga, deck 2. Emergency lighting, frost on the gratings, the airlock jammed.","translation":"«Ладога», палуба 2. Аварийный свет, иней на решётках, шлюз заклинило.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json caption"},
  {"text":"The doors of airlock 2 have opened all the way. Cold drifts out of the chamber, vapour creeps across the floor.","translation":"Створки шлюза №2 разошлись до конца. Из камеры тянет холодом, по полу стелется пар.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The doors of airlock 2 have parted a hand's width and stuck.","translation":"Створки шлюза №2 разошлись на ладонь и встали.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Airlock 2 has closed and locked.","translation":"Шлюз №2 сомкнулся и заблокировался.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has reached the airlock and taken hold of the manual drive's handle.","translation":"Вера дошла до шлюза и взялась за рукоять ручного привода.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has stopped at a porthole; beyond the glass, the red disc of the dwarf.","translation":"Вера остановилась у иллюминатора; за стеклом — красный диск карлика.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has gone back to the observation bay hatch.","translation":"Вера вернулась к люку смотрового отсека.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has disappeared into the airlock.","translation":"Вера скрылась в шлюзе.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"A trail of frost footprints from the airlock has reached the observation bay hatch.","translation":"Цепочка инеевых следов от шлюза дошла до люка смотрового отсека.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Ten percent of the oxygen is left in the corridor.","translation":"Кислорода в коридоре осталось десять процентов.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The speaker by the airlock has come alive: hiss on the channel of suit 2, as if someone is holding down the talk button.","translation":"Динамик у шлюза ожил: шипение на канале скафандра №2, будто кто-то держит тангенту.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"}
]}
