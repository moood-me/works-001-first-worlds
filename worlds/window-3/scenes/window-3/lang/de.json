  {"text":"BELT-EAST","translation":"GÜRTEL-OST","where":"worlds/window-3/scenes/window-3/elements/station.js"},
  {"text":"Window 3","translation":"Schalter 3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Ein elektronisches Wartesystem am Asteroidengürtel. Hier hat niemand es eilig. Außer dir.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Grenzposten Gürtel-Ost. Vierzig Minuten Flug bis zum Jupiter. Elf Tage bis zum Schalter.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Den Warpantrieb hat man erfunden. Das Formular F-12 in dreifacher Ausfertigung ist man nicht losgeworden.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Gena hat es zweimal ausgefüllt. Das dritte Exemplar ist davongeschwebt.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"Schalter 3 ist wieder offen.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"Schalter 3 ist wegen einer technischen Pause geschlossen.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Eine goldene Jacht mit Blaulicht ist ohne Anstehen direkt zum Schalter durchgefahren. Deine Nummer wurde neu berechnet.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} Tage","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"break","translation":"Pause","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Electronic queue · window 3","translation":"Elektronisches Wartesystem · Schalter 3","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Now","translation":"Jetzt","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Your number","translation":"Deine Nummer","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
