  {"text":"WINDOW 3","translation":"ВІКНО №3","where":"worlds/window-3/scenes/window-3/elements/inspector.js"},
  {"text":"NOW SERVING","translation":"ОБСЛУГОВУЄТЬСЯ","where":"worlds/window-3/scenes/window-3/elements/queue_board.js"},
  {"text":"YOUR NUMBER","translation":"ВАШ НОМЕР","where":"worlds/window-3/scenes/window-3/elements/queue_board.js"},
  {"text":"DEFINITELY NOT","translation":"ТОЧНО НЕ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"CONTRABAND","translation":"КОНТРАБАНДА","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"MODESTY","translation":"СКРОМНІСТЬ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"JU-77/3 · CARGO","translation":"ЮП-77/3 · ВАНТАЖНИЙ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"QUEUE HERE","translation":"ЧЕРГА ТУТ","where":"worlds/window-3/scenes/window-3/elements/stanchions.js"},
  {"text":"BELT-EAST","translation":"ПОЯС-СХІД","where":"worlds/window-3/scenes/window-3/elements/station.js"},
  {"text":"Window 3","translation":"Вікно №3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Електронна черга біля поясу астероїдів. Тут ніхто нікуди не поспішає — крім вас.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Пропускний пункт «Пояс-Схід». До Юпітера сорок хвилин льоту. До вікна — одинадцять діб.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Варп-двигун винайшли. Скасувати бланк Ф-12 у трьох примірниках — не змогли.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Гена заповнив його двічі. Третій примірник відлетів.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"Вікно №3 знову відкрите.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"Вікно №3 зачинилося на технічну перерву.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Золота яхта з мигалкою пройшла до вікна без черги. Ваш номер перераховано.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} діб","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"break","translation":"перерва","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Electronic queue · window 3","translation":"Електронна черга · вікно №3","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Now","translation":"Зараз","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Your number","translation":"Ваш номер","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Waiting","translation":"Очікування","where":"worlds/window-3/scenes/window-3/widgets/board.html"}
]}
