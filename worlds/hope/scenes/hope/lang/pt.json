{"strings": [
  {"text":"Hope","translation":"Esperança","where":"worlds/hope/scenes/hope/scene.json title"},
  {"text":"Night. An old pier. Silence.","translation":"Noite. Um velho píer. Silêncio.","where":"worlds/hope/scenes/hope/scene.json caption"},
  {"text":"Every evening she comes to the old pier.","translation":"Toda noite ela vem ao velho píer.","where":"worlds/hope/scenes/hope/scene.json captions[0] text"},
  {"text":"She counts the lights on the far shore.","translation":"Ela conta as luzes na outra margem.","where":"worlds/hope/scenes/hope/scene.json captions[1] text"},
  {"text":"Tonight there is one.","translation":"Hoje há uma.","where":"worlds/hope/scenes/hope/scene.json captions[2] text"},
  {"text":"So someone is still awake.","translation":"Então alguém ainda está acordado.","where":"worlds/hope/scenes/hope/scene.json captions[3] text"}
]}
