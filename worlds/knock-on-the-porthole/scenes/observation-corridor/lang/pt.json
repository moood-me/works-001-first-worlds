{"strings": [
  {"text":"AFT · HOLD 1","translation":"POPA · PORÃO 1","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"SEALED","translation":"LACRADO","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"AIRLOCK 2","translation":"ECLUSA 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
