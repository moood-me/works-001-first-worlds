{"strings": [
  {"text":"Hope","translation":"Hoffnung","where":"worlds/hope/scenes/hope/scene.json title"},
  {"text":"Night. An old pier. Silence.","translation":"Nacht. Ein alter Anleger. Stille.","where":"worlds/hope/scenes/hope/scene.json caption"},
  {"text":"Every evening she comes to the old pier.","translation":"Jeden Abend kommt sie zum alten Anleger.","where":"worlds/hope/scenes/hope/scene.json captions[0] text"},
  {"text":"She counts the lights on the far shore.","translation":"Sie zählt die Lichter am anderen Ufer.","where":"worlds/hope/scenes/hope/scene.json captions[1] text"},
  {"text":"Tonight there is one.","translation":"Heute Nacht ist es eins.","where":"worlds/hope/scenes/hope/scene.json captions[2] text"},
  {"text":"So someone is still awake.","translation":"Also ist noch jemand wach.","where":"worlds/hope/scenes/hope/scene.json captions[3] text"}
]}
