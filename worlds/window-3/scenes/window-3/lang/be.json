{"strings": [
  {"text":"WAIT BEHIND THE YELLOW LINE","translation":"ЧАКАЙЦЕ ЗА ЖОЎТАЙ ЛІНІЯЙ","where":"worlds/window-3/scenes/window-3/elements/deck.js"},
  {"text":"COFFEE 40 cr","translation":"КАВА · 40 кр","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"NO QUEUE*","translation":"БЕЗ ЧАРГІ*","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"hot","translation":"гарачая","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"*except coffee","translation":"*акрамя кавы","where":"worlds/window-3/scenes/window-3/elements/drone.js"},
  {"text":"BREAK","translation":"ПЕРАПЫНАК","where":"worlds/window-3/scenes/window-3/elements/inspector.js"},
  {"text":"WINDOW 3","translation":"АКНО №3","where":"worlds/window-3/scenes/window-3/elements/inspector.js"},
  {"text":"NOW SERVING","translation":"АБСЛУГОЎВАЕЦЦА","where":"worlds/window-3/scenes/window-3/elements/queue_board.js"},
  {"text":"YOUR NUMBER","translation":"ВАШ НУМАР","where":"worlds/window-3/scenes/window-3/elements/queue_board.js"},
  {"text":"DEFINITELY NOT","translation":"ДАКЛАДНА НЕ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"CONTRABAND","translation":"КАНТРАБАНДА","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"MODESTY","translation":"СЦІПЛАСЦЬ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"JU-77/3 · CARGO","translation":"ЮП-77/3 · ГРУЗАВЫ","where":"worlds/window-3/scenes/window-3/elements/ship.js"},
  {"text":"QUEUE HERE","translation":"ЧАРГА ТУТ","where":"worlds/window-3/scenes/window-3/elements/stanchions.js"},
  {"text":"BELT-EAST","translation":"ПОЯС-УСХОД","where":"worlds/window-3/scenes/window-3/elements/station.js"},
  {"text":"Window 3","translation":"Акно №3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Электронная чарга ля пояса астэроідаў. Тут ніхто нікуды не спяшаецца — акрамя цябе.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Пункт пропуску «Пояс-Усход». Да Юпітэра сорак хвілін лёту. Да акна — адзінаццаць сутак.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Варп-рухавік вынайшлі. Адмяніць бланк Ф-12 у трох экзэмплярах — не змаглі.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Гена запоўніў яго двойчы. Трэці экзэмпляр адляцеў.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"Акно №3 зноў адкрыта.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"Акно №3 зачынілася на тэхнічны перапынак.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Залатая яхта з мігалкай прайшла да акна без чаргі. Твой нумар пералічаны.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} сут.","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"break","translation":"перапынак","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Electronic queue · window 3","translation":"Электронная чарга · акно №3","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Now","translation":"Зараз","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Your number","translation":"Твой нумар","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Waiting","translation":"Чаканне","where":"worlds/window-3/scenes/window-3/widgets/board.html"}
]}
