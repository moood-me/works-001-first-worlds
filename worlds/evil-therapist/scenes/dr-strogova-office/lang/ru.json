{"strings": [
  {"text":"FILE No. 0417","translation":"ДЕЛО № 0417","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/desk.js"},
  {"text":"UNDER OBSERVATION","translation":"ПОД НАБЛЮДЕНИЕМ","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/desk.js"},
  {"text":"CASE FILES","translation":"ЛИЧНЫЕ ДЕЛА","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/deskfront.js"},
  {"text":"Dr I. V. Strogova","translation":"Д-р И. В. Строгова","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/nameplate.js"},
  {"text":"psychotherapist","translation":"психотерапевт","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/nameplate.js"},
  {"text":"ONE AT A TIME","translation":"ПО ОДНОЙ","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/tissues.js"},
  {"text":"it's just a mirror","translation":"это просто зеркало","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"EXIT","translation":"ВЫХОД —","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"only after the session","translation":"по окончании сеанса","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"YOUR FEELINGS MATTER*","translation":"ВАШИ ЧУВСТВА ВАЖНЫ*","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"*and will be noted","translation":"*и будут учтены","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"Dr Strogova's Office","translation":"Кабинет д-ра Строговой","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json title"},
  {"text":"Make yourself comfortable. As far as that's possible.","translation":"Устраивайтесь поудобнее. Насколько это возможно.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json caption"},
  {"text":"Sit down. The armchair is exactly where it should be.","translation":"Садитесь. Кресло стоит ровно там, где должно.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[0] text"},
  {"text":"Your file is already open. It's thicker than you thought.","translation":"Ваше дело уже открыто. Оно толще, чем вы думали.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[1] text"},
  {"text":"Tissues: one at a time. That is part of the therapy too.","translation":"Салфетки — по одной. Это тоже часть терапии.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[2] text"},
  {"text":"The clock on the wall says ten to three: the session's time is up.","translation":"Часы на стене показывают 14:50 — время сеанса вышло.","where":"worlds/evil-therapist/scenes/dr-strogova-office/script.js"},
  {"text":"The page in the file is full: the doctor has written it from top to bottom.","translation":"В деле кончилась страница: доктор исписала её целиком.","where":"worlds/evil-therapist/scenes/dr-strogova-office/script.js"}
]}
