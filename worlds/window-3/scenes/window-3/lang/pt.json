  {"text":"Window 3","translation":"Guichê 3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Uma fila de senha eletrônica no cinturão de asteroides. Aqui ninguém tem pressa. Menos você.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Posto de controle Cinturão-Leste. Quarenta minutos de voo até Júpiter. Onze dias até o guichê.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Inventaram o motor de dobra. Não conseguiram se livrar do formulário F-12 em três vias.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"O Gena preencheu duas vezes. A terceira via saiu flutuando.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"O guichê 3 está aberto de novo.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"O guichê 3 fechou para um intervalo técnico.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Um iate dourado com giroflex foi direto para o guichê, sem pegar fila. Sua senha foi recalculada.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} dias","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
