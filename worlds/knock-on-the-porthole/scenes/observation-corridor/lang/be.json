{"strings": [
  {"text":"AFT · HOLD 1","translation":"КАРМА · ТРУМ 1","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"SEALED","translation":"АПЕЧАТАНА","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/aft_bulkhead.js"},
  {"text":"AIRLOCK 2","translation":"ШЛЮЗ 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"LOCKED","translation":"ЗАБЛАКІРАВАНЫ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"STUCK","translation":"ЗАКЛІНІЛА","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"PARTLY OPEN","translation":"АДКРЫТЫ ЧАСТК.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"OPEN","translation":"АДКРЫТЫ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"MANUAL DRIVE","translation":"РУЧНЫ ПРЫВАД","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"SUIT 02 · CH. 2","translation":"СКАФ. 02 · КАН. 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"COMMS","translation":"СУВЯЗЬ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/intercom.js"},
  {"text":"JAMMED","translation":"ЗАКЛІНЕНЫ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AJAR","translation":"ПРЫАДКРЫТЫ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"LIDA · CORRIDOR 2-4","translation":"ЛІДА · КАРЫДОР 2-4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2: {state}","translation":"ШЛЮЗ 2: {state}","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CREW ON BOARD: 3/3","translation":"ЭКІПАЖ НА БОРЦЕ: 3/3","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: VOICE","translation":"КАН. 2: ГОЛАС","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"CH. 2: NOISE","translation":"КАН. 2: ШУМ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/lida.js"},
  {"text":"AIRLOCK 2  →","translation":"ШЛЮЗ 2  →","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"DECK 2 · SECT. 4","translation":"ПАЛУБА 2 · СЕКЦ. 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"CHECK PRESSURE BEFORE EXIT","translation":"ПРАВЕР ЦІСК ПЕРАД ВЫХАДАМ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_left.js"},
  {"text":"←  AIRLOCK 2","translation":"←  ШЛЮЗ 2","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"OBSERVATION BAY · 4","translation":"АГЛЯДНЫ АДСЕК · 4","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"O₂ · EMERG. MASKS","translation":"O₂ · АВАР. МАСКІ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/wall_right.js"},
  {"text":"Corridor by the Observation Bay","translation":"Калідор ля агляднага адсека","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json title"},
  {"text":"The Ladoga, deck 2. Emergency lighting, frost on the gratings, the airlock jammed.","translation":"«Ладага», палуба 2. Аварыйнае святло, шэрань на кратах, шлюз заклініла.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/scene.json caption"},
  {"text":"The doors of airlock 2 have opened all the way. Cold drifts out of the chamber, vapour creeps across the floor.","translation":"Створкі шлюза №2 разышліся да канца. З камеры цягне холадам, па падлозе сцелецца пара.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The doors of airlock 2 have parted a hand's width and stuck.","translation":"Створкі шлюза №2 разышліся на далонь і сталі.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Airlock 2 has closed and locked.","translation":"Шлюз №2 самкнуўся і заблакіраваўся.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has reached the airlock and taken hold of the manual drive's handle.","translation":"Вера дайшла да шлюза і ўзялася за дзяржальна ручнога прывада.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has stopped at a porthole; beyond the glass, the red disc of the dwarf.","translation":"Вера спынілася ля ілюмінатара; за шклом — чырвоны дыск карліка.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has gone back to the observation bay hatch.","translation":"Вера вярнулася да люка агляднага адсека.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Vera has disappeared into the airlock.","translation":"Вера знікла ў шлюзе.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"A trail of frost footprints from the airlock has reached the observation bay hatch.","translation":"Ланцужок слядоў шэрані ад шлюза дайшоў да люка агляднага адсека.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"Ten percent of the oxygen is left in the corridor.","translation":"Кіслароду ў калідоры засталося дзесяць працэнтаў.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"},
  {"text":"The speaker by the airlock has come alive: hiss on the channel of suit 2, as if someone is holding down the talk button.","translation":"Дынамік ля шлюза ажыў: шыпенне на канале скафандра №2, быццам нехта трымае тангенту.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/script.js"}
]}
