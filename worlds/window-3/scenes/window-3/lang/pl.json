  {"text":"QUEUE HERE","translation":"KOLEJKA TUTAJ","where":"worlds/window-3/scenes/window-3/elements/stanchions.js"},
  {"text":"BELT-EAST","translation":"PAS-WSCHÓD","where":"worlds/window-3/scenes/window-3/elements/station.js"},
  {"text":"Window 3","translation":"Okienko 3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Elektroniczna kolejka przy pasie planetoid. Nikt się tu nigdzie nie spieszy – oprócz ciebie.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Punkt kontrolny „Pas-Wschód”. Do Jowisza czterdzieści minut lotu. Do okienka – jedenaście dób.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"Napęd warp wynaleziono. Formularza F-12 w trzech egzemplarzach zlikwidować się nie udało.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Gena wypełnił go dwa razy. Trzeci egzemplarz odleciał.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"Okienko 3 znów jest otwarte.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"Okienko 3 zamknięto na przerwę techniczną.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Złoty jacht z kogutem podleciał do okienka bez kolejki. Twój numer przeliczono.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"≈ {days} days","translation":"≈ {days} d.","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"break","translation":"przerwa","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Electronic queue · window 3","translation":"Elektroniczna kolejka · okienko 3","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Now","translation":"Teraz","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Your number","translation":"Twój numer","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Waiting","translation":"Oczekiwanie","where":"worlds/window-3/scenes/window-3/widgets/board.html"}
