  {"text":"LOCKED","translation":"ЗАБЛОКОВАНИЙ","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"STUCK","translation":"ЗАКЛИНИЛО","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
  {"text":"PARTLY OPEN","translation":"ВІДКРИТИЙ ЧАСТК.","where":"worlds/knock-on-the-porthole/scenes/observation-corridor/elements/airlock.js"},
