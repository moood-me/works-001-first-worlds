{"strings": [
  {"text":"Hope","translation":"希望","where":"worlds/hope/scenes/hope/scene.json title"},
  {"text":"Night. An old pier. Silence.","translation":"夜。一座老碼頭。一片寂靜。","where":"worlds/hope/scenes/hope/scene.json caption"},
  {"text":"Every evening she comes to the old pier.","translation":"每天傍晚，她都來到老碼頭。","where":"worlds/hope/scenes/hope/scene.json captions[0] text"},
  {"text":"She counts the lights on the far shore.","translation":"她數著對岸的燈火。","where":"worlds/hope/scenes/hope/scene.json captions[1] text"},
  {"text":"Tonight there is one.","translation":"今晚只有一盞。","where":"worlds/hope/scenes/hope/scene.json captions[2] text"},
  {"text":"So someone is still awake.","translation":"所以，還有人醒著。","where":"worlds/hope/scenes/hope/scene.json captions[3] text"}
]}
