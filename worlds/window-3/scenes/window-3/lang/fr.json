  {"text":"Window 3","translation":"Guichet 3","where":"worlds/window-3/scenes/window-3/scene.json title"},
  {"text":"An electronic queue at the asteroid belt. Nobody here is in a hurry. Except you.","translation":"Une file d’attente électronique à la ceinture d’astéroïdes. Ici, personne n’est pressé. Sauf toi.","where":"worlds/window-3/scenes/window-3/scene.json caption"},
  {"text":"Belt-East checkpoint. Forty minutes' flight to Jupiter. Eleven days to the window.","translation":"Poste de contrôle Ceinture-Est. Quarante minutes de vol jusqu’à Jupiter. Onze jours jusqu’au guichet.","where":"worlds/window-3/scenes/window-3/scene.json captions[0] text"},
  {"text":"They invented the warp drive. They couldn't get rid of form F-12 in triplicate.","translation":"On a inventé la propulsion warp. On n’a pas réussi à supprimer le formulaire F-12 en trois exemplaires.","where":"worlds/window-3/scenes/window-3/scene.json captions[1] text"},
  {"text":"Gena filled it in twice. The third copy floated away.","translation":"Guéna l’a rempli deux fois. Le troisième exemplaire s’est envolé.","where":"worlds/window-3/scenes/window-3/scene.json captions[2] text"},
  {"text":"Window 3 is open again.","translation":"Le guichet 3 est de nouveau ouvert.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"Window 3 has closed for a technical break.","translation":"Le guichet 3 a fermé pour une pause technique.","where":"worlds/window-3/scenes/window-3/script.js"},
  {"text":"A golden yacht with a flashing light went straight to the window, no queue. Your number has been recalculated.","translation":"Un yacht doré avec un gyrophare est passé droit au guichet, sans faire la queue. Ton numéro a été recalculé.","where":"worlds/window-3/scenes/window-3/script.js"},
