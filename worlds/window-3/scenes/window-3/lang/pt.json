  {"text":"Electronic queue · window 3","translation":"Senha eletrônica · guichê 3","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Now","translation":"Agora","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
  {"text":"Your number","translation":"Sua senha","where":"worlds/window-3/scenes/window-3/widgets/board.html"},
