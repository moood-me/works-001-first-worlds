{"strings": [
  {"text":"FILE No. 0417","translation":"AKTA NR 0417","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/desk.js"},
  {"text":"UNDER OBSERVATION","translation":"POD OBSERWACJĄ","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/desk.js"},
  {"text":"CASE FILES","translation":"AKTA OSOBOWE","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/deskfront.js"},
  {"text":"Dr I. V. Strogova","translation":"Dr I. W. Strogowa","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/nameplate.js"},
  {"text":"psychotherapist","translation":"psychoterapeutka","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/nameplate.js"},
  {"text":"ONE AT A TIME","translation":"PO JEDNEJ","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/tissues.js"},
  {"text":"it's just a mirror","translation":"to tylko lustro","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"EXIT","translation":"WYJŚCIE","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"only after the session","translation":"dopiero po sesji","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"YOUR FEELINGS MATTER*","translation":"TWOJE UCZUCIA SĄ WAŻNE*","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"*and will be noted","translation":"*i zostaną odnotowane","where":"worlds/evil-therapist/scenes/dr-strogova-office/elements/wall.js"},
  {"text":"Dr Strogova's Office","translation":"Gabinet dr Strogowej","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json title"},
  {"text":"Make yourself comfortable. As far as that's possible.","translation":"Rozgość się. O ile to możliwe.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json caption"},
  {"text":"Sit down. The armchair is exactly where it should be.","translation":"Usiądź. Fotel stoi dokładnie tam, gdzie powinien.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[0] text"},
  {"text":"Your file is already open. It's thicker than you thought.","translation":"Twoje akta są już otwarte. Grubsze, niż się zdawało.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[1] text"},
  {"text":"Tissues: one at a time. That is part of the therapy too.","translation":"Chusteczki – po jednej. To też część terapii.","where":"worlds/evil-therapist/scenes/dr-strogova-office/scene.json captions[2] text"},
  {"text":"The clock on the wall says ten to three: the session's time is up.","translation":"Zegar na ścianie wskazuje za dziesięć trzecią – czas sesji dobiegł końca.","where":"worlds/evil-therapist/scenes/dr-strogova-office/script.js"},
  {"text":"The page in the file is full: the doctor has written it from top to bottom.","translation":"W aktach skończyła się strona: pani doktor zapisała ją od góry do dołu.","where":"worlds/evil-therapist/scenes/dr-strogova-office/script.js"}
]}
